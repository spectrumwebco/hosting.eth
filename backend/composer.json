{
    "name": "hosting-eth/backend",
    "description": "Backend for hosting.eth web3 domain registration platform",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "spiral/framework": "^3.0",
        "spiral/roadrunner-bridge": "^3.0",
        "cycle/orm": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "spiral/testing": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php app.php",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
